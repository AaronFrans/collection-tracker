PORT=3001

# Turso (libSQL) database — create with the Turso CLI:
#   turso db create collection-tracker
#   turso db show collection-tracker --url
#   turso db tokens create collection-tracker
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Comma-separated list of origins allowed to call the API (your deployed client URL, plus localhost for dev)
CORS_ORIGIN=http://localhost:5173

# Shared password required to use the app — pick something only you know.
APP_PASSWORD=change-me